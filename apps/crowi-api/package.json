{
  "name": "@crowi/api",
  "version": "2.0.0-dev",
  "main": "src/app.ts",
  "description": "The simple & powerful Wiki - API Server",
  "tags": [
    "wiki",
    "communication",
    "documentation",
    "collaboration"
  ],
  "author": "Sotaro KARASAWA <s@sotaro.com>",
  "contributors": [
    "lightnet328 <lightnet328@gmail.com>",
    "otofune <otofune@gmail.com>",
    "Norio Suzuki <norio.suzuki@gmail.com>"
  ],
  "license": "MIT",
  "_moduleAliases": {
    "src": "dist"
  },
  "scripts": {
    "start": "NODE_ENV=production node dist/app.js",
    "dev": "DEBUG=crowi:* NODE_ENV=development nodemon src/app.ts",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "test": "env -u DEBUG TZ=UTC jest --maxWorkers=5",
    "test:server": "env -u DEBUG jest lib --maxWorkers=5",
    "coverage": "npm test -- --coverage",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "clean": "rm -rf dist",
    "crypto:gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": {
    "@crowi/api-contract": "workspace:^",
    "@crowi/plugin-api": "workspace:^",
    "@slack/client": "^5.0.2",
