{
  "name": "@crowi/dev-runner",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Local development runner for Crowi 2.0.",
  "scripts": {
    "dev": "DEBUG=crowi:* NODE_ENV=development nodemon ../crowi-api/src/app.ts",
    "start": "NODE_ENV=production node ../crowi-api/dist/app.js"
  },
  "dependencies": {
    "@crowi/admin-cli": "workspace:^",
    "@crowi/api": "workspace:^",
    "@crowi/plugin-aws": "workspace:^",
    "@crowi/plugin-renderer-crowi-legacy": "workspace:^",
    "@crowi/plugin-search-elasticsearch": "workspace:^",
    "@crowi/plugin-storage-aws-s3": "workspace:^",
    "@crowi/plugin-storage-local": "workspace:^"
  },
  "devDependencies": {
    "nodemon": "^1.19.4",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^5.8.3"
  }
}
