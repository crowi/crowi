{
  "name": "@crowi/site",
  "version": "0.1.1-alpha.1",
  "private": true,
  "description": "crowi.wiki — Landing page and documentation site",
  "scripts": {
    "dev": "env -u AI_AGENT -u CLAUDECODE -u CLAUDE_CODE -u CLAUDE_CODE_IS_COWORK -u CODEX_SANDBOX -u CODEX_CI -u CODEX_THREAD_ID next dev --turbopack --port ${PORT_SITE:-4303}",
    "build": "next build",
    "start": "next start --port ${PORT_SITE:-4303}",
    "lint": "eslint",
    "check:links": "node ../../scripts/check-docs-links.mjs",
    "check:vocabulary": "node ../../scripts/check-docs-vocabulary.mjs",
    "type-check": "tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "preview": "next build && npx serve@latest out"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.10.4",
    "fumadocs-mdx": "^15.0.12",
    "fumadocs-ui": "^16.10.4",
    "lucide-react": "catalog:",
    "next": "16.3.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@crowi/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.13",
    "@types/node": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "catalog:",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "^8.0.16"
  }
}
