{
  "extends": "@crowi/tsconfig/app-web.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@/.source/*": ["./.source/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "source.config.ts"
  ],
  "exclude": ["node_modules", "out", ".next"]
}
