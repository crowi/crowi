---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Crowi API Test Tool">
  <main>
    <h1>Crowi API Unit Test Tool</h1>
    
    <div class="api-tester">
      <div class="form-section">
        <div class="method-url-group">
          <select id="method" class="method-select">
            <option value="GET">GET</option>
            <option value="POST">POST</option>
            <option value="PUT">PUT</option>
            <option value="DELETE">DELETE</option>
            <option value="PATCH">PATCH</option>
          </select>
          <input type="text" id="url" class="url-input" placeholder="http://localhost:3000/api/v2/login" value="http://localhost:3000/api/v2/login">
        </div>

        <div class="headers-section">
          <h3>Headers</h3>
          <div id="headers-container">
            <div class="header-row">
              <input type="text" class="header-key" placeholder="Content-Type" value="Content-Type">
              <input type="text" class="header-value" placeholder="application/json" value="application/json">
              <button class="remove-header" onclick="removeHeader(this)">×</button>
            </div>
          </div>
          <button id="add-header" class="add-header-btn">+ Add Header</button>
        </div>

        <div class="body-section">
          <h3>Request Body</h3>
          <textarea id="body" class="body-input" placeholder='{"key": "value"}'></textarea>
        </div>

        <button id="send-request" class="send-btn">Send Request</button>
      </div>

      <div class="response-section">
        <h3>Response</h3>
        <div class="response-meta">
          <span id="status-code"></span>
          <span id="response-time"></span>
        </div>
        <pre id="response" class="response-viewer"></pre>
      </div>
    </div>
  </main>
</Layout>

<style>
  main {
    margin: auto;
    padding: 1rem;
    max-width: 1200px;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 2rem;
    color: #333;
  }

  .api-tester {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .form-section, .response-section {
    background: #f5f5f5;
    padding: 1.5rem;
    border-radius: 8px;
  }

  .method-url-group {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .method-select {
    padding: 0.5rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
    min-width: 100px;
  }

  .url-input {
    flex: 1;
    padding: 0.5rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
  }

  h3 {
    margin-bottom: 1rem;
    color: #555;
  }

  .headers-section {
    margin-bottom: 1.5rem;
  }

  .header-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .header-key, .header-value {
    flex: 1;
    padding: 0.5rem;
    border: 1px solid #ddd;
    border-radius: 4px;
  }

  .remove-header {
    padding: 0.5rem 1rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
    font-size: 1.2rem;
    line-height: 1;
  }

  .remove-header:hover {
    background: #fee;
    border-color: #f00;
  }

  .add-header-btn {
    padding: 0.5rem 1rem;
    border: 1px solid #4CAF50;
    border-radius: 4px;
    background: #fff;
    color: #4CAF50;
    cursor: pointer;
  }

  .add-header-btn:hover {
    background: #4CAF50;
    color: white;
  }

  .body-input {
    width: 100%;
    min-height: 150px;
    padding: 0.5rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-family: monospace;
    resize: vertical;
  }

  .send-btn {
    width: 100%;
    padding: 1rem;
    margin-top: 1.5rem;
    border: none;
    border-radius: 4px;
    background: #2196F3;
    color: white;
    font-size: 1.1rem;
    cursor: pointer;
  }

  .send-btn:hover {
    background: #1976D2;
  }

  .send-btn:disabled {
    background: #ccc;
    cursor: not-allowed;
  }

  .response-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
    color: #666;
  }

  #status-code {
    font-weight: bold;
  }

  #status-code.success {
    color: #4CAF50;
  }

  #status-code.error {
    color: #f44336;
  }

  .response-viewer {
    background: #fff;
    padding: 1rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    min-height: 200px;
    max-height: 500px;
    overflow: auto;
    font-family: monospace;
    font-size: 0.9rem;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  @media (max-width: 768px) {
    .api-tester {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function removeHeader(button) {
    button.parentElement.remove();
  }

  document.addEventListener('DOMContentLoaded', () => {
    const addHeaderBtn = document.getElementById('add-header');
    const headersContainer = document.getElementById('headers-container');
    const sendBtn = document.getElementById('send-request');
    const responseEl = document.getElementById('response');
    const statusCodeEl = document.getElementById('status-code');
    const responseTimeEl = document.getElementById('response-time');

    addHeaderBtn.addEventListener('click', () => {
      const headerRow = document.createElement('div');
      headerRow.className = 'header-row';
      headerRow.innerHTML = `
        <input type="text" class="header-key" placeholder="Header name">
        <input type="text" class="header-value" placeholder="Header value">
        <button class="remove-header" onclick="removeHeader(this)">×</button>
      `;
      headersContainer.appendChild(headerRow);
    });

    sendBtn.addEventListener('click', async () => {
      const method = document.getElementById('method').value;
      const url = document.getElementById('url').value;
      const bodyText = document.getElementById('body').value;

      // Collect headers
      const headers = {};
      document.querySelectorAll('.header-row').forEach(row => {
        const key = row.querySelector('.header-key').value.trim();
        const value = row.querySelector('.header-value').value.trim();
        if (key) {
          headers[key] = value;
        }
      });

      // Prepare request options
      const options = {
        method,
        headers,
      };

      // Add body for non-GET requests
      if (method !== 'GET' && bodyText) {
        try {
          options.body = bodyText;
        } catch (e) {
          responseEl.textContent = `Invalid request body: ${e.message}`;
          return;
        }
      }

      // Disable button and show loading
      sendBtn.disabled = true;
      sendBtn.textContent = 'Sending...';
      responseEl.textContent = 'Loading...';
      statusCodeEl.textContent = '';
      statusCodeEl.className = '';
      responseTimeEl.textContent = '';

      const startTime = Date.now();

      try {
        const response = await fetch(url, options);
        const responseTime = Date.now() - startTime;

        // Update status code
        statusCodeEl.textContent = `Status: ${response.status} ${response.statusText}`;
        statusCodeEl.className = response.ok ? 'success' : 'error';
        responseTimeEl.textContent = `Time: ${responseTime}ms`;

        // Get response text
        const contentType = response.headers.get('content-type');
        let responseData;
        
        if (contentType && contentType.includes('application/json')) {
          responseData = await response.json();
          responseEl.textContent = JSON.stringify(responseData, null, 2);
        } else {
          responseData = await response.text();
          responseEl.textContent = responseData;
        }

      } catch (error) {
        statusCodeEl.textContent = 'Error';
        statusCodeEl.className = 'error';
        responseEl.textContent = `Error: ${error.message}\n\nThis might be a CORS error if calling from a different origin.`;
      } finally {
        sendBtn.disabled = false;
        sendBtn.textContent = 'Send Request';
      }
    });
  });
</script>