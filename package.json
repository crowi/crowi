{
  "name": "crowi",
  "version": "2.0.0-dev",
  "private": true,
  "description": "The simple & powerful Wiki",
  "author": "Sotaro KARASAWA <s@sotaro.com>",
  "contributors": [
    "lightnet328 <lightnet328@gmail.com>",
    "otofune <otofune@gmail.com>",
    "Norio Suzuki <norio.suzuki@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/crowi/crowi.git"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.x",
    "pnpm": ">=9.0.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev --concurrency=20 --filter @crowi/api --filter @crowi/web --filter @crowi/api-contract --filter @crowi/collab --filter @crowi/runner --filter \"@crowi/plugin-*\"",
    "dev:api": "turbo run dev --concurrency=20 --filter @crowi/api --filter @crowi/api-contract --filter @crowi/collab --filter @crowi/runner --filter \"@crowi/plugin-*\"",
    "dev:web": "turbo run dev --filter @crowi/web",
    "dev:site": "turbo run dev --filter @crowi/site",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:server": "turbo run test:server",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:workspace": "node scripts/check-workspace-protocol.mjs",
    "clean": "turbo run clean",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGES.md -s"
  },
  "bugs": {
    "url": "https://github.com/crowi/crowi/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@changesets/cli": "^2.31.0",
    "conventional-changelog-cli": "^5.0.0",
    "lefthook": "^2.1.6",
    "turbo": "^2.5.4"
  }
}