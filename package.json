{
  "name": "crowi",
  "version": "2.0.0-dev",
  "private": true,
  "description": "The simple & powerful Wiki",
  "author": "Sotaro KARASAWA <s@sotaro.com>",
  "contributors": [
    "lightnet328 <lightnet328@gmail.com>",
    "otofune <otofune@gmail.com>",
    "Norio Suzuki <norio.suzuki@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/crowi/crowi.git"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.x",
    "pnpm": ">=10.12.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.34.3",
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "5.7.3",
      "minimatch@9.0.3": "9.0.9",
      "postcss@<8.5.18": "8.5.18",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "@hono/node-server@<2.0.11": "2.0.11",
      "sharp@<0.35.3": "0.35.3",
      "brace-expansion@1": "1.1.17",
      "brace-expansion@2": "2.1.3",
      "brace-expansion@5": "5.0.9"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "turbo run dev --concurrency=30 --filter @crowi/api --filter @crowi/api-contract --filter @crowi/collab --filter @crowi/runner --filter \"@crowi/plugin-*\"",
    "dev:web": "turbo run dev --filter @crowi/web",
    "dev:site": "turbo run dev --filter @crowi/site",
    "dev:portal": "node scripts/dev-portal/index.mjs",
    "migrate": "node scripts/migrate.mjs",
    "build": "turbo run build",
    "build:images": "node scripts/build-images.mjs",
    "test": "turbo run test --concurrency=3",
    "test:scripts": "node --test scripts/*.test.mjs packages/*/scripts/*.test.mjs",
    "test:flake": "node scripts/test-flake-report.mjs",
    "test:flake-taxonomy": "node scripts/test-flake-taxonomy.mjs",
    "test:server": "turbo run test:server",
    "lint": "node scripts/check-kebab-filenames.mjs && turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:workspace": "node scripts/check-workspace-protocol.mjs",
    "check:packages": "node scripts/check-package-publishable.mjs",
    "check:filenames": "node scripts/check-kebab-filenames.mjs",
    "check:openapi": "node scripts/check-openapi-fresh.mjs",
    "smoke:oauth-well-known": "node scripts/smoke-oauth-well-known-proxy.mjs",
    "clean": "turbo run clean",
    "e2e": "pnpm --filter @crowi/e2e e2e",
    "e2e:report": "pnpm --filter @crowi/e2e exec playwright show-report"
  },
  "bugs": {
    "url": "https://github.com/crowi/crowi/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@changesets/cli": "^2.31.0",
    "lefthook": "^2.1.6",
    "turbo": "^2.9.16"
  }
}
