  "scripts": {
    "start": "node dist/server/app.js",
    "dev": "concurrently --kill-others 'npm run dev:server'",
    "dev:server": "DEBUG=crowi:* NODE_ENV=development nodemon src/app.ts",
    "format": "eslint --fix '**/*.{ts,tsx,js,jsx}'",
    "lint": "eslint '**/*.{ts,tsx,js,jsx}'",
    "test": "env -u DEBUG TZ=UTC jest --maxWorkers=5",
    "test:server": "env -u DEBUG jest lib --maxWorkers=5",
    "coverage": "npm test -- --coverage",
    "build": "run-s build:*",
    "build:server": "npm run prod:server",
    "prod:server": "tsc",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch"
  },
  "env": {
    "NODE_ENV": "production"
