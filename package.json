{
  "name": "crowi-monorepo",
  "version": "2.0.0-dev",
  "private": true,
  "description": "The simple & powerful Wiki - Monorepo",
  "author": "Sotaro KARASAWA <s@sotaro.com>",
  "contributors": [
    "lightnet328 <lightnet328@gmail.com>",
    "otofune <otofune@gmail.com>",
    "Norio Suzuki <norio.suzuki@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/crowi/crowi.git"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10.x",
    "pnpm": ">=8.0.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter @crowi/api",
    "dev:web": "turbo run dev --filter @crowi/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:server": "turbo run test:server",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "format": "turbo run format",
    "clean": "turbo run clean",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGES.md -s"
  },
  "bugs": {
    "url": "https://github.com/crowi/crowi/issues"
  },
  "devDependencies": {
    "conventional-changelog-cli": "^5.0.0",
    "turbo": "^1.13.3"
  }
}