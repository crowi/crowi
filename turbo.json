{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "globalPassThroughEnv": [
    "BASE_URL",
    "CLIENT_URL",
    "COLLAB_MAX_EDITORS_PER_PAGE",
    "CROWI_ENCRYPTION_KEY",
    "HOSTNAME",
    "JWT_ACCESS_TOKEN_TTL_SECONDS",
    "JWT_REFRESH_TOKEN_TTL_SECONDS",
    "MONGO_URI",
    "PASSWORD_SEED",
    "PORT",
    "REDISTOGO_URL",
    "REDIS_REJECT_UNAUTHORIZED",
    "REDIS_TLS_URL",
    "REDIS_URL",
    "WS_TOKEN_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        ".astro/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "@crowi/collab#test": {
      "dependsOn": [
        "^build",
        "@crowi/api#build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:server": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
