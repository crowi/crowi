{
  "name": "@crowi/plugin-search-elasticsearch",
  "version": "0.1.0-dev",
  "description": "Elasticsearch 9 search driver for Crowi 2.0.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@crowi/plugin-api": "workspace:^",
    "@elastic/elasticsearch": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
