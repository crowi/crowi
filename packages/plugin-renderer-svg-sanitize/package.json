{
  "name": "@crowi/plugin-renderer-svg-sanitize",
  "version": "0.1.0-alpha.1",
  "description": "Shared DOM-based SVG sanitizer for Crowi 2.x renderer plugins (@crowi/plugin-renderer-mermaid, @crowi/plugin-renderer-plantuml). Not a renderer plugin itself — a policy-parameterised sanitize function + test vectors, consumed as a workspace dependency.",
  "repository": {
    "type": "git",
    "url": "https://github.com/crowi/crowi.git",
    "directory": "packages/plugin-renderer-svg-sanitize"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10"
  },
  "devDependencies": {
    "@crowi/tsconfig": "workspace:*",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
