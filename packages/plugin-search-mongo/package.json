{
  "name": "@crowi/plugin-search-mongo",
  "version": "0.1.0-alpha.2",
  "description": "Infra-free MongoDB $regex search driver for Crowi 2.0.",
  "repository": {
    "type": "git",
    "url": "https://github.com/crowi/crowi.git",
    "directory": "packages/plugin-search-mongo"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "lint": "eslint src/ --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "dependencies": {
    "@crowi/plugin-api": "workspace:^"
  },
  "devDependencies": {
    "@crowi/plugin-api": "workspace:*",
    "@crowi/tsconfig": "workspace:*",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "catalog:",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^9.7.3",
    "ts-jest": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
