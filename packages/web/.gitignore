# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# paraglide compiled output (generated from messages/ — predev / prebuild script regenerates).
# `**/paraglide` (not just `/paraglide`) so a stray output dir from a typo'd
# `--outdir` flag (e.g. `--outdir ./src/paraglide`) also stays out of git.
**/paraglide

# scripts/paraglide-compile.mjs bookkeeping (lockfile, content-hash stamp,
# disposable staging dir) — deliberately kept OUTSIDE `paraglide/` above so it
# never shows up as filesystem churn in the dir Turbopack watches.
.paraglide-meta/
