{
  "name": "@crowi/plugin-storage-aws-s3",
  "version": "0.1.0-dev",
  "description": "AWS S3 storage driver for Crowi 2.0. Depends on @crowi/plugin-aws for shared credentials.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@crowi/plugin-api": "^0.1.0",
    "@crowi/plugin-aws": "^0.1.0",
    "zod": "^3.23.8"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  },
  "devDependencies": {
    "@crowi/plugin-api": "workspace:*",
    "@crowi/plugin-aws": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "zod": "^3.23.8"
  }
}
