{
  "name": "@crowi/runner",
  "version": "0.1.0-alpha.3",
  "description": "Crowi 2.0 runner library: loads crowi.config.json and resolves plugin npm names to CrowiPlugin instances. Pure library — no process bootstrap responsibility.",
  "repository": {
    "type": "git",
    "url": "https://github.com/crowi/crowi.git",
    "directory": "packages/runner"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@crowi/plugin-api": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@crowi/plugin-api": "workspace:*",
    "@crowi/tsconfig": "workspace:*",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
