{
  "name": "@crowi/plugin-renderer-emoji",
  "version": "0.1.0-alpha.1",
  "description": "Emoji shortcode renderer for Crowi 2.x. Replaces `:smile:` and friends with Unicode emoji via remark-emoji. Skips code blocks and inline code.",
  "repository": {
    "type": "git",
    "url": "https://github.com/crowi/crowi.git",
    "directory": "packages/plugin-renderer-emoji"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@crowi/plugin-api": "workspace:^",
    "jiti": "^2.7.0",
    "remark-emoji": "^5.0.1"
  },
  "devDependencies": {
    "@crowi/plugin-api": "workspace:*",
    "@crowi/tsconfig": "workspace:*",
    "@types/jest": "catalog:",
    "@types/mdast": "^4.0.4",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "remark-parse": "^11.0.0",
    "ts-jest": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "unified": "^11.0.5"
  }
}
