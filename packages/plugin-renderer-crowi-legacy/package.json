{
  "name": "@crowi/plugin-renderer-crowi-legacy",
  "version": "0.1.0-dev",
  "description": "Crowi v1 compatibility renderer for Crowi 2.x. Re-enables v1's single-newline → <br> behaviour via remark-breaks. Intended for installs migrating from Crowi 1.x; fresh installs leave it disabled.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "peerDependencies": {
    "@crowi/plugin-api": "^0.1.0"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "remark-breaks": "^4.0.0"
  },
  "devDependencies": {
    "@crowi/plugin-api": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "remark-parse": "^11.0.0",
    "ts-jest": "^29.3.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "unified": "^11.0.5"
  }
}
