{
  "name": "@crowi/plugin-storage-gcs",
  "version": "0.1.0-alpha.1",
  "description": "Native Google Cloud Storage driver for Crowi 2.0. Uses Application Default Credentials by default, with an encrypted inline service-account key as fallback.",
  "repository": {
    "type": "git",
    "url": "https://github.com/crowi/crowi.git",
    "directory": "packages/plugin-storage-gcs"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "dependencies": {
    "@crowi/plugin-api": "workspace:^",
    "@google-cloud/storage": "7.21.0"
  },
  "devDependencies": {
    "@crowi/plugin-api": "workspace:*",
    "@crowi/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
