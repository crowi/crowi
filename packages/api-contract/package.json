{
  "name": "@crowi/api-contract",
  "version": "1.0.0",
  "description": "API contract definitions for Crowi using ts-rest and zod",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "type-check": "tsc --noEmit",
    "generate-openapi": "node scripts/generate-openapi.js"
  },
  "dependencies": {
    "@ts-rest/core": "catalog:",
    "@ts-rest/open-api": "^3.52.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@crowi/tsconfig": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "js-yaml": "^4.1.0",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
