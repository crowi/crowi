{
  "name": "@crowi/api-contract",
  "version": "1.0.0",
  "description": "API contract definitions for Crowi using ts-rest and zod",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "type-check": "tsc --noEmit",
    "generate-openapi": "tsx scripts/generate-openapi.ts",
    "test": "tsx --test src/contracts/admin/index.test.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@ts-rest/core": "catalog:",
    "hono": "^4.10.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@crowi/tsconfig": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "js-yaml": "^4.1.0",
    "tsup": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
