{
  "name": "@crowi/api-contract",
  "version": "2.0.0-alpha.16",
  "description": "API contract definitions for Crowi using Hono + zod-openapi",
  "repository": {
    "type": "git",
    "url": "https://github.com/crowi/crowi.git",
    "directory": "packages/api-contract"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./openapi": {
      "types": "./dist/generated/openapi.d.ts",
      "import": "./dist/generated/openapi.mjs",
      "require": "./dist/generated/openapi.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "type-check": "tsc --noEmit",
    "generate-openapi": "tsx scripts/generate-openapi.ts",
    "generate-openapi-types": "tsx scripts/generate-openapi-types.ts",
    "generate": "pnpm generate-openapi && pnpm generate-openapi-types",
    "test": "tsx --test src/contracts/admin/index.test.ts src/util/html-elements.test.ts src/schemas/username.test.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "hono": "^4.12.34",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@crowi/tsconfig": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "js-yaml": "^4.3.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
