{
  "extends": "@crowi/tsconfig/app-node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"]
    },
    "composite": true,
    "declaration": true,
    "sourceMap": true,
    "noEmit": false,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react",
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src"],
  "exclude": ["**/*.test.ts", "**/*.test.js", "src/test/**/*", "dist"],
  "tsc-alias": {
    "replacers": {
      "base-url": {
        "enabled": false
      }
    }
  }
}
