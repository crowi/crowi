                          "value": "R"
                        }
                      ]
                    },
                    {
                      "type": "tableCell",
                      "children": [
                        {
                          "type": "text",
                          "value": "C"
                        }
                      ]
                    },
                    {
                      "type": "tableCell",
                      "children": [
                        {
                          "type": "text",
                          "value": "D"
