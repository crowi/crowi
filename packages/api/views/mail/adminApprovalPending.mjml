<mj-text font-size="20px" font-weight="700" padding="24px 24px 8px">{{ t.adminApprovalPending.heading }}</mj-text>
<mj-text padding="0 24px 8px">{{ t.adminApprovalPending.intro }}</mj-text>
<mj-text padding="0 24px 16px" font-size="15px"><strong>{{ createdUserName }}</strong><br /><span style="color:#6b7280;">{{ createdUserEmail }}</span></mj-text>
<mj-button href="{{ adminUsersUrl }}" background-color="#3b6e72" color="#ffffff" font-size="15px" font-weight="600" border-radius="8px" padding="0 24px 20px" inner-padding="12px 28px">
  {{ t.adminApprovalPending.cta }}
</mj-button>
<mj-text padding="0 24px 16px" font-size="13px" color="#6b7280">{{ t.common.linkFallback }}<br /><a href="{{ adminUsersUrl }}" style="color:#3b6e72;word-break:break-all;">{{ adminUsersUrl }}</a></mj-text>
