{
  "name": "@crowi/api",
  "version": "2.0.0-dev",
  "main": "dist/app.js",
  "types": "dist/app.d.ts",
  "bin": {
    "crowi-api": "./dist/app.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "description": "The simple & powerful Wiki - API Server",
  "tags": [
    "wiki",
    "communication",
    "documentation",
    "collaboration"
  ],
  "author": "Sotaro KARASAWA <s@sotaro.com>",
  "contributors": [
    "lightnet328 <lightnet328@gmail.com>",
    "otofune <otofune@gmail.com>",
    "Norio Suzuki <norio.suzuki@gmail.com>"
  ],
  "license": "MIT",
  "scripts": {
    "start": "NODE_ENV=production node dist/app.js",
    "dev": "cd ../.. && NODE_ENV=development tsx watch --tsconfig packages/api/tsconfig.json --clear-screen=false packages/api/src/app.ts",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "test": "env -u DEBUG TZ=UTC jest --maxWorkers=5",
    "test:server": "env -u DEBUG jest lib --maxWorkers=5",
    "coverage": "npm test -- --coverage",
    "build": "tsc && tsc-alias",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "crypto:gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "prepublishOnly": "chmod +x dist/app.js"
  },
  "dependencies": {
    "@crowi/api-contract": "workspace:^",
    "@crowi/collab": "workspace:^",
    "@crowi/plugin-api": "workspace:^",
    "@crowi/runner": "workspace:^",
    "@hocuspocus/extension-redis": "^4.0.0",
    "@hocuspocus/server": "^4.0.0",
    "@hono/node-server": "^2.0.3",
    "@hono/zod-openapi": "^1.4.0",
    "@scalar/hono-api-reference": "^0.10.16",
    "async": "~1.5.0",
    "bcryptjs": "^3.0.3",
    "csrf": "~3.1.0",
    "date-fns": "^2.1.0",
    "debug": "~4.1.1",
    "dotenv": "^16.5.0",
    "github-slugger": "^2.0.0",
    "hono": "^4.10.0",
    "jiti": "^2.7.0",
    "jsonwebtoken": "^9.0.2",
    "mdast-util-to-string": "^4.0.0",
    "mjml": "^4.18.0",
    "mongoose": "^6.13.8",
    "mongoose-paginate": "5.0.x",
    "redis": "^4.7.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.0.2",
    "unified": "^11.0.5",
    "uuid": "^11.1.0",
    "ws": "^8.20.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@crowi/plugin-renderer-crowi-legacy": "workspace:*",
    "@crowi/plugin-renderer-emoji": "workspace:*",
    "@crowi/plugin-renderer-katex": "workspace:*",
    "@crowi/plugin-renderer-plantuml": "workspace:*",
    "@crowi/plugin-mail-smtp": "workspace:*",
    "@crowi/plugin-mail-resend": "workspace:*",
    "@crowi/plugin-mail-aws-ses": "workspace:*",
    "@crowi/plugin-search-elasticsearch": "workspace:*",
    "@crowi/plugin-search-opensearch": "workspace:*",
    "@crowi/plugin-storage-aws-s3": "workspace:*",
    "@crowi/plugin-storage-local": "workspace:*",
    "@crowi/tsconfig": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/csrf": "^1.3.2",
    "@types/debug": "^4.1.5",
    "@types/faker": "^4.1.7",
    "@types/jest": "catalog:",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mdast": "^4.0.4",
    "@types/mjml": "^4.7.4",
    "@types/node": "catalog:",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "faker": "^4.1.0",
    "jest": "catalog:",
    "mongodb-memory-server": "^10.1.4",
    "regenerator-runtime": "^0.13.3",
    "supertest": "^4.0.2",
    "ts-jest": "catalog:",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.0",
    "typescript": "catalog:"
  }
}
