{
  "name": "@crowi/api",
  "version": "2.0.0-alpha.17",
  "main": "dist/app.js",
  "types": "dist/app.d.ts",
  "bin": {
    "crowi-api": "./dist/app.js"
  },
  "files": [
    "dist",
    "views",
    "public",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "description": "The simple & powerful Wiki - API Server",
  "repository": {
    "type": "git",
    "url": "https://github.com/crowi/crowi.git",
    "directory": "packages/api"
  },
  "tags": [
    "wiki",
    "communication",
    "documentation",
    "collaboration"
  ],
  "author": "Sotaro KARASAWA <s@sotaro.com>",
  "contributors": [
    "lightnet328 <lightnet328@gmail.com>",
    "otofune <otofune@gmail.com>",
    "Norio Suzuki <norio.suzuki@gmail.com>"
  ],
  "license": "MIT",
  "scripts": {
    "start": "NODE_ENV=production node dist/app.js",
    "dev": "cd ../../apps/crowi-runner && NODE_ENV=development tsx watch --tsconfig ../../packages/api/tsconfig.json --clear-screen=false --env-file-if-exists=../../.env ../../packages/api/src/app.ts",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "test": "env -u DEBUG TZ=UTC node --no-sparkplug node_modules/jest/bin/jest.js --maxWorkers=5 ${CROWI_TEST_JSON_OUTPUT_FILE:+--json --outputFile=$CROWI_TEST_JSON_OUTPUT_FILE}",
    "test:server": "env -u DEBUG jest lib --maxWorkers=5",
    "coverage": "npm test -- --coverage",
    "build": "tsc && tsc-alias",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "crypto:gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "prepublishOnly": "chmod +x dist/app.js"
  },
  "dependencies": {
    "@crowi/api-contract": "workspace:^",
    "@crowi/collab": "workspace:^",
    "@crowi/plugin-api": "workspace:^",
    "@crowi/runner": "workspace:^",
    "@hocuspocus/extension-redis": "^4.0.0",
    "@hocuspocus/server": "^4.0.0",
    "@hono/mcp": "catalog:",
    "@hono/node-server": "^2.0.11",
    "@hono/zod-openapi": "^1.4.0",
    "@modelcontextprotocol/sdk": "catalog:",
    "@scalar/hono-api-reference": "^0.10.16",
    "bcryptjs": "^3.0.3",
    "date-fns": "^2.1.0",
    "debug": "^4.4.3",
    "dotenv": "^16.5.0",
    "github-slugger": "^2.0.0",
    "hono": "^4.12.34",
    "hono-rate-limiter": "catalog:",
    "ioredis": "^5.6.1",
    "jiti": "^2.7.0",
    "jsonwebtoken": "^9.0.2",
    "mdast-util-to-string": "^4.0.0",
    "mjml": "^5.3.0",
    "mongoose": "^9.7.3",
    "mongoose-paginate-v2": "^1.9.1",
    "openid-client": "^6.8.4",
    "redis": "^6.2.1",
    "remark-breaks": "^4.0.0",
    "remark-emoji": "^5.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.3",
    "shiki": "^4.0.2",
    "unified": "^11.0.5",
    "ws": "^8.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1060.0",
    "@aws-sdk/s3-request-presigner": "^3.1060.0",
    "@crowi/plugin-slack": "workspace:*",
    "@crowi/plugin-storage-gcs": "workspace:*",
    "@crowi/tsconfig": "workspace:*",
    "@faker-js/faker": "^9.9.0",
    "@google-cloud/storage": "7.21.0",
    "@hocuspocus/provider": "^4.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/debug": "^4.1.5",
    "@types/jest": "catalog:",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mdast": "^4.0.4",
    "@types/mjml": "^5.0.0",
    "@types/node": "catalog:",
    "@types/unist": "^3.0.3",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "^8.57.1",
    "form-data": "^4.0.6",
    "jest": "catalog:",
    "jest-environment-node": "catalog:",
    "mdast-util-to-hast": "^13.2.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemailer": "^9.0.1",
    "regenerator-runtime": "^0.13.3",
    "supertest": "^7.2.2",
    "ts-jest": "catalog:",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.8"
  }
}
