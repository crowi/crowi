config/default.js
node_modules/
tmp/
bower_components/
.env
data
npm-debug.log
coverage

# client
public/js/*
public/css/*
public/uploads/*

# server
dist

# Paraglide-js generated messages (regenerated on every pnpm predev / prebuild / pretype-check)
packages/web/paraglide/

# Turborepo
.turbo
**/.turbo/

# TypeScript build info
*.tsbuildinfo

# local settings
.claude/settings.local.json

# scheduler runtime lock (/loop + /schedule); process-specific, never share
.claude/scheduled_tasks.lock

# feature state (new-feature workflow) — fully untracked. The directory is not
# tracked at all (no .gitkeep) so `gw` worktrees can replace it with a symlink
# back to the main worktree's copy via ~/.gw/hooks/feature-state-link.sh,
# keeping a single shared store in the root repo.
.feature-state/

# Guard against accidental writes to the legacy nested path
.claude/feature-state/

# Worktree-local review notes (generated by code-review skill)
.reviews/
