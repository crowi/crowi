PORT=4301
PASSWORD_SEED="yourpasswordseed"
MONGO_URI="mongodb://localhost/crowi"
# Optional for single-instance deployments, **required** for multi-instance
# ones (every instance MUST point at the same Redis; page content always
# lives in MongoDB, never Redis). Backs 7 consumers — collab pub/sub,
# editor-cap counter, presence, notification invalidation, Config sync,
# rate limiting, LRU — each with its own degrade behavior when unset: see
# operations/realtime-collab in the docs for the per-consumer table.
REDIS_URL=redis://localhost:6379
NODE_ENV="development"
SECRET_TOKEN=""
ENABLE_DNSCACHE=""

# Client URL for CORS (required in production, optional in development)
# In development, localhost origins are automatically allowed
CLIENT_URL="http://localhost:4302"

# [@crowi/plugin-slack dev only] Override the public origin used to build the
# generated Slack App manifest's `event_subscriptions.request_url`. Slack cannot
# reach `localhost`, so in development run a tunnel (ngrok / cloudflared) and set
# this to its public origin (e.g. https://abc123.ngrok.app). When unset, the
# manifest's request_url falls back to CLIENT_URL. Production normally leaves this
# blank (CLIENT_URL is already public).
# SLACK_MANIFEST_REQUEST_URL=

# [web container only] The URL the Next.js web SERVER uses to reach the api via
# next.config.ts's rewrites() proxy. IMPORTANT: with `output: 'standalone'` this
# is BAKED AT BUILD — the running `node server.js` does NOT re-read it — so it
# only takes effect where the config is evaluated per request: `pnpm dev` and
# Vercel's edge (set it as a Vercel build env). For self-host PRODUCTION the
# recommended topology is a front reverse proxy that routes /api,/files,WS to the
# api; there Next never proxies /api and this var is unused. See
# operations/deployment in the docs.
# CROWI_API_URL=http://api:3000

# [web container only] Browser-facing absolute api origin for the CROSS-ORIGIN
# topology (B): web and api on different hosts with no single front proxy. Read
# at RUNTIME — the root layout injects window.__ENV from this value via a
# synchronous inline script on each request — so setting it on the web container
# at start points one built image at any api origin with NO rebuild. When unset,
# the browser uses relative `/api/v2` paths on its own origin (same-origin
# default). When set, you MUST also set CLIENT_URL=<web origin> on the api so its
# CORS allows the cross-origin browser calls (exact-match origin).
# NOTE: cross-origin is LIMITED — inline attachment images / avatars / file
# downloads use relative URLs and a first-party cookie, so they break against a
# separate api origin. Prefer the same-origin proxy (A) or Vercel edge proxy (C).
# See operations/deployment in the docs.
# NEXT_PUBLIC_API_URL=https://api.example.com

# Master key used to encrypt sensitive Config values (OAuth secrets, AWS keys,
# SMTP password, Slack token) at rest. Must decode to exactly 32 bytes.
# Generate with: openssl rand -base64 32   (or: pnpm --filter @crowi/api crypto:gen-key)
# When unset, sensitive values fall back to plaintext (legacy behaviour) and a
# warning is logged on startup. Strongly recommended to set in production.
CROWI_ENCRYPTION_KEY=""

# Signing secret for the short-lived wsToken JWT issued by
# `GET /api/v2/pages/:id/yjs-token` (RFC-0003 realtime collaboration).
# REQUIRED for a MULTI-INSTANCE deployment (set CROWI_MULTI_INSTANCE below):
# it must be shared verbatim by every api replica, otherwise a token minted by
# one node cannot be verified by another and collab connections fail
# intermittently. Generate with: openssl rand -base64 32
#
# Deliberately LEFT EMPTY here — we never ship a real (world-known) secret in a
# template. Single-instance dev boots fine with it unset: the api generates a
# per-process random secret (a startup warning is logged), which is harmless for
# one replica. Set a real value in production once you scale past one api node.
WS_TOKEN_SECRET=""

# Declare a MULTI-INSTANCE api deployment (more than one api replica). Accepts a
# boolean (`1` / `true`) or a replica count (`>= 2`). This is the signal the
# WS_TOKEN_SECRET boot guard keys off: when set, booting WITHOUT a stable
# WS_TOKEN_SECRET aborts (a per-process random secret can't be cross-verified
# across replicas). `CROWI_MULTI_INSTANCE=1` (or `true`, or a replica count)
# ENABLES multi-instance mode; leave it unset (or `0` / `false`) for
# single-instance (the default), where the per-process random fallback is fine.
# REDIS_URL presence alone does NOT imply multi-instance — Redis is also used by
# single-replica deployments.
# CROWI_MULTI_INSTANCE=

# Optional: explicit browser-side WebSocket endpoint for the realtime
# namespaces (collab / presence / notifications). Read at RUNTIME (window.__ENV,
# like NEXT_PUBLIC_API_URL above), so it can be set on the web container at start
# with no rebuild. Resolution order when unset:
#   1. NEXT_PUBLIC_API_URL (cross-origin) — used as-is
#   2. dev (NODE_ENV=development) → http://localhost:4301 — the api dev port,
#      because the Next dev server cannot proxy the WS upgrade and window.location
#      (:4302) has no WS server
#   3. window.location (same-origin self-host image) — the browser dials its own
#      origin; the OUTER reverse proxy must route /collab,/presence,
#      /notifications WS upgrades to the api (Next's rewrites() is HTTP-only and
#      does NOT forward WS upgrades). See operations/deployment in the docs.
# Set this to wss://<api origin> in the cross-origin topology (B), on Vercel (C)
# where the edge cannot proxy WS, or when realtime is fronted on a distinct host
# (e.g. wss://collab.example.com).
# NEXT_PUBLIC_COLLAB_URL=

# Maximum simultaneous editors per page (RFC-0003 §Phase 6). Clients above this
# cap are issued readonly wsTokens and connect in live-subscribe mode (writes
# rejected). Tracked in Redis as `crowi:collab:editors:<pageId>` (Set, 24h TTL);
# when REDIS_URL is unset, the cap is effectively disabled (fail-open). Default 20.
COLLAB_MAX_EDITORS_PER_PAGE=20
