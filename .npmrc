enable-pre-post-scripts=true
engine-strict=true

# Hoist @crowi/plugin-* (and the @crowi/runner library) into the repo
# root's node_modules/. In dev the api boots with cwd = apps/crowi-runner
# (the reference runner project), and @crowi/runner resolves plugins via
# createRequire(apps/crowi-runner/package.json). apps/crowi-runner declares
# the plugins as direct deps so they're symlinked into its own node_modules,
# but Node's parent-directory lookup also reaches the repo-root hoist — this
# keeps resolution robust across hoisting layouts. External runners are
# unaffected: their plugins live in their own node_modules, resolved the same
# way. (Hoist-free resolution may be revisited in a follow-up; see the
# feature task's npmrc_hoist decision.)
public-hoist-pattern[]=@crowi/plugin-*
public-hoist-pattern[]=@crowi/runner
