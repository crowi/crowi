enable-pre-post-scripts=true
engine-strict=true

# Hoist @crowi/plugin-* (and the @crowi/runner library) into the repo
# root's node_modules/ so @crowi/runner's createRequire(repoRoot/package.json)
# can resolve them when the api boots with the repo root as CWD (the
# dev-runner dir that used to host the plugin deps is gone — root is
# the dev runner now). User-environment runners are unaffected: their
# plugins live in their own node_modules and are resolved the same way.
public-hoist-pattern[]=@crowi/plugin-*
public-hoist-pattern[]=@crowi/runner
