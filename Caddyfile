# Minimal same-origin front proxy for the docker-compose `app` profile.
#
# The browser talks only to this one origin (Caddy); Caddy routes by path so
# the web app stays same-origin — relative `/api`, `/files`, inline
# attachment images, the first-party auth cookie and the realtime WebSockets
# all work without baking any api URL into the web image. This mirrors the
# recommended self-host topology (A) in operations/deployment.
#
# Caddy forwards the WebSocket `Upgrade` automatically — no extra config needed.
:80 {
	# HTTP API + attachments + OAuth/well-known metadata → api. `/.well-known/*`
	# is intentionally broad (not just oauth-authorization-server) so future
	# OAuth metadata (e.g. RFC 9728 oauth-protected-resource) is covered
	# without another Caddyfile edit — see packages/web/next.config.ts's
	# rewrites() comment for why this route MUST stay same-origin-to-api and
	# never fall back to the web app. ACME challenges (`/.well-known/acme-
	# challenge/*`) are unaffected: Caddy's TLS automation handles those in an
	# internal handler that runs before reverse_proxy, so this matcher never
	# sees them.
	@api path /api/* /files/* /.well-known/*
	reverse_proxy @api api:3000

	# Realtime WebSocket namespaces → api. The browser dials the bare namespace
	# (`/collab`, `/presence`, `/notifications`) — Hocuspocus / presence /
	# notifications carry the document / page id in the protocol, not the path —
	# so each matcher must list the exact path AND the `/*` sub-path form: in
	# Caddy `path /collab/*` does NOT match a bare `/collab`.
	@ws path /collab /collab/* /presence /presence/* /notifications /notifications/*
	reverse_proxy @ws api:3000

	# Everything else → web (Next.js)
	reverse_proxy web:3000
}
