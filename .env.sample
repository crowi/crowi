# Crowi Environment Variables Sample
# Copy this file to .env and configure for your development environment

# Server Configuration
PORT=3000
NODE_ENV="development"
BASE_URL=http://localhost:3000

# Required: Password seed for user password hashing
PASSWORD_SEED="changethissecretstring"

# Required: Secret token for session cookies
SECRET_TOKEN="anothersecretstring"

# Database Configuration
# MongoDB - connects to Docker container on port 37017
MONGO_URI="mongodb://localhost:37017/crowi"

# Redis Configuration - connects to Docker container on port 16379
REDIS_URL="redis://localhost:16379"

# Optional: Elasticsearch (currently disabled)
# ELASTICSEARCH_URI=http://localhost:9200/crowi

# File Upload Configuration
# Options: aws, local, none
FILE_UPLOAD="local"

# Optional Features
# MATHJAX=1
# PLANTUML_URI=http://localhost:18080
# ENABLE_DNSCACHE=true