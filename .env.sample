PORT=3000
PASSWORD_SEED="yourpasswordseed"
MONGO_URI="mongodb://localhost/crowi"
ELASTICSEARCH_URI=http://localhost:9200/crowi
REDIS_URL=redis://localhost:6379
NODE_ENV="development"
SECRET_TOKEN=""
ENABLE_DNSCACHE=""

# Client URL for CORS (required in production, optional in development)
# In development, localhost origins are automatically allowed
CLIENT_URL="http://localhost:3301"

# Master key used to encrypt sensitive Config values (OAuth secrets, AWS keys,
# SMTP password, Slack token) at rest. Must decode to exactly 32 bytes.
# Generate with: openssl rand -base64 32   (or: pnpm --filter @crowi/api crypto:gen-key)
# When unset, sensitive values fall back to plaintext (legacy behaviour) and a
# warning is logged on startup. Strongly recommended to set in production.
CROWI_ENCRYPTION_KEY=""

# Signing secret for the short-lived wsToken JWT issued by
# `GET /api/v2/pages/:id/yjs-token` (RFC-0003 realtime collaboration). Must be
# shared verbatim by every Crowi api instance in a multi-server deployment,
# otherwise tokens minted by one node cannot be verified by another.
# Generate with: openssl rand -base64 32
# When unset, each process generates a random secret in-memory at boot; that is
# fine for a single-instance deployment but breaks across restarts and across
# multiple api instances.
WS_TOKEN_SECRET=""

# Optional: explicit browser-side WebSocket endpoint for collaborative editing
# (RFC-0003 Phase 9). When unset, the browser derives the endpoint from
# window.location (= same host the page was served from), and Next.js's
# `/collab/*` rewrite (see packages/web/next.config.ts) forwards the upgrade
# to the api process. Set this only when you front collab on a distinct host
# from the api (e.g. wss://collab.example.com).
# NEXT_PUBLIC_COLLAB_URL=

# Maximum simultaneous editors per page (RFC-0003 §Phase 6). Clients above this
# cap are issued readonly wsTokens and connect in live-subscribe mode (writes
# rejected). Tracked in Redis as `crowi:collab:editors:<pageId>` (Set, 24h TTL);
# when REDIS_URL is unset, the cap is effectively disabled (fail-open). Default 20.
COLLAB_MAX_EDITORS_PER_PAGE=20
